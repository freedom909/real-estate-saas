####################################
# Alibaba Cloud ECS Production .env
# Copy to .env and fill in real values
####################################

NODE_ENV=production

# Auth / Security
ACCESS_TOKEN_SECRET=CHANGE_ME_base64_secret
REFRESH_TOKEN_SECRET=CHANGE_ME_base64_secret
JWT_SECRET=CHANGE_ME_hex_or_base64_secret
GATEWAY_SECRET=CHANGE_ME_gateway_secret
NAKANO_ENCRYPTION_KEY=CHANGE_ME_base64_32byte
INTERNAL_SERVICE_TOKEN=CHANGE_ME_service_token

# OpenAI
OPENAI_API_KEY=sk-CHANGE_ME

# MySQL / 阿里云 RDS
DB_NAME=nakano
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_HOST=rm-xxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_DIALECT=mysql

# MongoDB (Atlas or 阿里云 MongoDB)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/sendai

# Redis / 阿里云 Tair
REDIS_URL=redis://:password@host:6379

# Frontend / CORS
FRONTEND_URL=https://minshuku.info
SESSION_COOKIE_DOMAIN=minshuku.info

# Storage: OSS for production, MINIO for local dev
STORAGE_PROVIDER=OSS

# 阿里云 OSS (if STORAGE_PROVIDER=OSS)
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://minshuku.oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=minshuku
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME

# Subgraph URLs (default: 127.0.0.1:PORT/graphql for host network mode)
SUBGRAPH_HOST=127.0.0.1

# Cloudflare Tunnel (health check endpoint)
HEALTH_URL=https://api.minshuku.info/health
