FROM node:20-slim

WORKDIR /app

# Install bash (should already be present but ensure it)
RUN apt-get update && apt-get install -y bash && rm -rf /var/lib/apt/lists/*

# Cache bust - force rebuild everything
ENV CACHE_DATE=2026-07-25T19:00:00Z

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --no-audit --no-fund

# Copy source code
COPY . .

# Make scripts executable
RUN chmod +x scripts/*.sh scripts/*.js

CMD ["bash", "scripts/start-railway.sh"]
