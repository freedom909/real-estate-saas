FROM node:20-slim

WORKDIR /app

# Cache bust - force rebuild everything
ENV CACHE_DATE=2026-07-26T00:00:00Z

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --no-audit --no-fund

# Copy source code
COPY . .

# Make scripts executable
RUN chmod +x scripts/*.sh scripts/*.cjs

ENV PORT=4000
EXPOSE 4000

CMD ["bash", "scripts/start-railway.sh"]
